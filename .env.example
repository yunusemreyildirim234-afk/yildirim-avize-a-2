# Yıldırım Avize — ortam değişkenleri ŞABLONU. Yalnız ADLAR ve açıklamalar vardır; DEĞER YAZMAYIN, gerçek değerler .env.local / Vercel panelindedir.
# Üretimde zorunlu olanlar (lib/env-check.ts): NEXTAUTH_SECRET, DATABASE_URL, PAYTR_*, KARGONOMI_API_KEY/TOKEN/WEBHOOK_SECRET, CRON_SECRET, RESEND_API_KEY, BLOB_READ_WRITE_TOKEN.

# --- Veritabanı (Neon / PostgreSQL) ---
# Uygulamanın kullandığı havuzlu bağlantı adresi (zorunlu)
DATABASE_URL=
# Prisma işlemleri için doğrudan (havuzsuz) bağlantı adresi
DIRECT_URL=

# --- Oturum ve güvenlik ---
# Oturum çerezlerini imzalayan gizli anahtar (zorunlu)
NEXTAUTH_SECRET=
# Vercel Cron çağrılarını doğrulayan gizli anahtar (zorunlu; boşsa cron uçları kapalıdır)
CRON_SECRET=
# Yönetici girişinin .env ile yapılmasına izin ver (yalnız "1" ise açık; acil kurtarma ve e2e)
ADMIN_ENV_LOGIN=
# .env ile yönetici girişi kullanıcı adı (yalnız ADMIN_ENV_LOGIN=1 iken)
ADMIN_USER=
# .env ile yönetici girişi parolası (yalnız ADMIN_ENV_LOGIN=1 iken)
ADMIN_PASSWORD=

# --- Google ile giriş ---
# Google OAuth istemci kimliği
GOOGLE_CLIENT_ID=
# Google OAuth istemci gizli anahtarı
GOOGLE_CLIENT_SECRET=

# --- PayTR (kartlı ödeme) ---
# Mağaza numarası (zorunlu)
PAYTR_MERCHANT_ID=
# Mağaza parolası (zorunlu)
PAYTR_MERCHANT_KEY=
# Mağaza gizli anahtarı (zorunlu)
PAYTR_MERCHANT_SALT=
# Test modu anahtarı (canlıda boş/kapalı olmalı)
PAYTR_TEST_MODE=
# Eski adlandırma: PAYTR_MERCHANT_* yoksa yedek olarak okunur
MERCHANT_ID=
MERCHANT_KEY=
MERCHANT_SALT=

# --- Kargonomi (Aras Kargo gönderi entegrasyonu) ---
# API anahtarı (zorunlu)
KARGONOMI_API_KEY=
# API jetonu (zorunlu)
KARGONOMI_API_TOKEN=
# Kargo durum bildirimi (webhook) doğrulama anahtarı (zorunlu)
KARGONOMI_WEBHOOK_SECRET=
# API adresi (boşsa varsayılan kullanılır)
KARGONOMI_API_URL=
KARGONOMI_BASE_URL=
# Varsayılan taşıyıcı kimliği (Aras Kargo)
KARGONOMI_DEFAULT_CARRIER=
# Depo kimliği
KARGONOMI_WAREHOUSE_ID=
# Gönderici bilgileri (gönderi kaydındaki gönderen alanları)
KARGONOMI_SENDER_NAME=
KARGONOMI_SENDER_EMAIL=
KARGONOMI_SENDER_PHONE=
KARGONOMI_SENDER_TAX_NUMBER=
KARGONOMI_SENDER_TAX_PLACE=
KARGONOMI_SENDER_ADDRESS=
KARGONOMI_SENDER_STATE_ID=
KARGONOMI_SENDER_CITY_ID=

# --- E-posta (Resend) ---
# Resend API anahtarı (zorunlu)
RESEND_API_KEY=
# Gönderen adresi ("Ad <adres@alanadi>" biçimi)
RESEND_FROM=

# --- Dosya depolama (Vercel Blob) ---
# Blob okuma/yazma jetonu (zorunlu)
BLOB_READ_WRITE_TOKEN=

# --- Site ---
# Sitenin açık adresi (bağlantılar, SEO, e-posta bağlantıları için)
NEXT_PUBLIC_SITE_URL=
# Google Tag Manager kimliği (boşsa etiket yüklenmez)
NEXT_PUBLIC_GTM_ID=

# --- Trendyol eşleştirme (isteğe bağlı) ---
# Trendyol satıcı numarası
TRENDYOL_SUPPLIER_ID=
# Trendyol API anahtarı
TRENDYOL_API_KEY=
# Trendyol API gizli anahtarı
TRENDYOL_API_SECRET=
# Trendyol jetonu
TRENDYOL_TOKEN=
